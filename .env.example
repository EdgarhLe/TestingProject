# Copy file này thành .env và điền giá trị thực
# Không commit file .env lên git

# ── Đường dẫn dữ liệu ──────────────────────────────────
DATA_ROOT=/path/to/ai-challenge-dataset
INDEX_ROOT=/path/to/indexes
CHECKPOINT_DIR=/path/to/checkpoints
REMOTE_DIR=/path/to/remote/checkpoints  # dùng cho rsync từ Máy 1 sang Máy 2

# ── API Server ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Model ──────────────────────────────────────────────
PREDICTOR_MODEL=Qwen/Qwen2.5-0.5B      # hoặc 1.5B tuỳ GPU
Y_ENCODER_MODEL=BAAI/bge-m3
X_ENCODER_MODEL=facebook/vjepa2-vitl   # cập nhật sau khi xác nhận tên model chính thức

# ── Training (Máy 1 only) ────────────────────────────────
MACHINE_ROLE=dev            # "training" trên Máy 1, "dev" trên Máy 2
MACHINE2_HOST=              # IP/hostname Máy 2 (dùng cho rsync từ Máy 1)

# ── Frontend ────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
